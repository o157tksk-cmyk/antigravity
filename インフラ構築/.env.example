# ==========================================
# インフラ環境変数テンプレート (.env.example)
# ==========================================

# アプリケーション基本設定
APP_ENV=development
APP_PORT=8080
SECRET_KEY=change_me_in_production_secret_key_12345

# データベース (PostgreSQL) 設定
DB_HOST=db
DB_PORT=5432
DB_NAME=app_db
DB_USER=postgres
DB_PASSWORD=postgres_password

# キャッシュ (Redis) 設定
REDIS_HOST=redis
REDIS_PORT=6379

# クラウド設定 (AWS / GCP / Azure 共通キーの例)
CLOUD_REGION=ap-northeast-1
CLOUD_PROJECT_ID=my-infrastructure-project
